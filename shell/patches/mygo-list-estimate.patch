+++ b/ui/list_estimate_test.go
@@ -0,0 +1,42 @@
+package ui
+
+import (
+	"math"
+	"testing"
+)
+
+func TestListTallInitialEstimateLimitsWork(t *testing.T) {
+	s := ListState{EstimatedRowHeight: 1000}
+	built := map[int]bool{}
+	tt := coreNewTester(func(c *context) {
+		coreList(c, &s, 100, func(i int) {
+			built[i] = true
+			coreBox(c).Height(1000)
+		}).Fill()
+	}, 400, 500)
+	if len(built) > 1+listOverscan {
+		t.Fatalf("built %d tall rows for one visible row", len(built))
+	}
+	checkRows(t, tt, &s, 0, 0, 500)
+	s.ScrollToEnd()
+	tt.Frame()
+	if _, last := s.Visible(); last != 99 {
+		t.Fatalf("cannot reach last row: %d", last)
+	}
+}
+
+func TestListInaccurateInitialEstimateFillsViewport(t *testing.T) {
+	for _, estimate := range []float32{1, 1000, 0, -1, float32(math.NaN()), float32(math.Inf(1))} {
+		s := ListState{EstimatedRowHeight: estimate}
+		tt := coreNewTester(func(c *context) {
+			coreList(c, &s, 100, func(i int) {
+				coreBox(c).Height(varied(i))
+			}).Fill()
+		}, 400, 500)
+		checkRows(t, tt, &s, 0, 0, 500)
+		tt.Scroll(100, 100, 0, 300)
+		checkRows(t, tt, &s, 0, 0, 500)
+		tt.SetSize(300, 600)
+		checkRows(t, tt, &s, 0, 0, 600)
+	}
+}
