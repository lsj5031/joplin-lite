+// opaqueSurface preserves each corner's shape without sampling the backdrop.
+func opaqueSurface(p *ui.Painter, box ui.Rect, radii [4]float32, color ui.Color, border bool) {
+	color.A = 255
+	if border && p.Preferences().HighContrast {
+		line := p.Theme().Border
+		line.A = 255
+		fillGradient(p, box, radii, ui.LinearGradient{From: line, To: line})
+		box = ui.Rect{X: box.X + 1, Y: box.Y + 1, W: box.W - 2, H: box.H - 2}
+		for i := range radii {
+			radii[i] = max(0, radii[i]-1)
+		}
+	}
+	if box.W > 0 && box.H > 0 {
+		fillGradient(p, box, radii, ui.LinearGradient{From: color, To: color})
+	}
