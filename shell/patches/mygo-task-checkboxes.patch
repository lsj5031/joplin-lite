+package markdown
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/egoist/mygo/ui"
+)
+
+func TestTaskToggleMouseAndKeyboard(t *testing.T) {
+	for _, source := range []string{
+		"- [ ] task",
+		"1. [ ] task",
+		"> - [ ] task",
+		"- parent\n  - [ ] task",
+		"中文\n\n- [X] task\r\n",
+	} {
+		t.Run(source, func(t *testing.T) {
+			src := source
+			calls := 0
+			o := &Options{OnTask: func(offset int, checked bool) {
+				want := strings.Index(src, "[") + 1
+				if offset != want || checked == (src[offset] != ' ') {
+					t.Fatalf("callback offset=%d checked=%v, source=%q", offset, checked, src)
+				}
+				value := " "
+				if checked {
+					value = "x"
+				}
+				src = src[:offset] + value + src[offset+1:]
+				calls++
+			}}
+			tt := ui.NewTester(func(c *ui.Context) { View(c, src, o) }, 600, 400)
+			if err := tt.Click("Task: task"); err != nil {
+				t.Fatal(err)
+			}
+			if calls != 1 {
+				t.Fatalf("mouse callback count = %d", calls)
+			}
+			tt.Key(0, ui.KeySpace)
+			if calls != 2 {
+				t.Fatalf("keyboard callback count = %d", calls)
+			}
+			if got, want := src[strings.Index(src, "[")+1] != ' ', strings.Contains(source, "[X]"); got != want {
+				t.Fatal("second toggle did not restore task state")
+			}
+		})
+	}
+}
+
+func TestTaskMarkersRemainDisplayOnlyWithoutCallback(t *testing.T) {
+	tt := ui.NewTester(func(c *ui.Context) { View(c, "- [ ] task", nil) }, 600, 400)
+	if _, ok := tt.Find("Task: task"); ok {
+		t.Fatal("display-only task became interactive")
+	}
+	if !tt.HasText("task") {
+		t.Fatal("display-only task text disappeared")
+	}
+}
