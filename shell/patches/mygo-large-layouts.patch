@@ -0,0 +1,150 @@
+package text
+
+import (
+	"fmt"
+	"runtime"
+	"strings"
+	"testing"
+	"weak"
+)
+
+func largeParagraph(suffix string) Params {
+	return Params{Text: strings.Repeat("mixed 中文。 ", 10000) + suffix, Width: 700}
+}
+
+func TestLargeLayoutBudgetProtectsLabels(t *testing.T) {
+	s := newSystem()
+	s.eng = &stubEngine{}
+	p := Params{Text: "ordinary label"}
+	label := s.Layout(p)
+	ordinaryBytes := s.layoutBytes
+	for i := range 12 {
+		s.Layout(largeParagraph(fmt.Sprint(i)))
+		if s.largeLayoutBytes > maxLargeLayoutBytes {
+			t.Fatalf("large layouts retained %d bytes", s.largeLayoutBytes)
+		}
+		if s.layoutBytes != ordinaryBytes || s.Layout(p) != label {
+			t.Fatal("large layouts displaced ordinary labels")
+		}
+		s.EndFrame()
+	}
+}
+
+func TestLargeLayoutKeepsRecentParagraphs(t *testing.T) {
+	s := newSystem()
+	s.eng = &stubEngine{}
+	a, b := largeParagraph("a"), largeParagraph("b")
+	first, second := s.Layout(a), s.Layout(b)
+	for range 12 {
+		s.EndFrame()
+		if s.Layout(a) != first || s.Layout(b) != second {
+			t.Fatal("alternating visible paragraphs evicted each other")
+		}
+	}
+}
+
+func TestLargeLayoutEvictsLeastRecentParagraph(t *testing.T) {
+	s := newSystem()
+	s.eng = &stubEngine{}
+	a, b := largeParagraph("a"), largeParagraph("b")
+	first := s.Layout(a)
+	s.EndFrame()
+	old := weak.Make(s.Layout(b))
+	s.EndFrame()
+	s.Layout(a)
+	s.Layout(largeParagraph("c"))
+	if s.Layout(a) != first {
+		t.Fatal("evicted the recently used paragraph")
+	}
+	runtime.GC()
+	if old.Value() != nil {
+		t.Fatal("evicted paragraph is still retained")
+	}
+	runtime.KeepAlive(s)
+}
+
+func TestLargeLayoutExpiresAndClears(t *testing.T) {
+	for _, clearCache := range []bool{false, true} {
+		t.Run(fmt.Sprint(clearCache), func(t *testing.T) {
+			s := newSystem()
+			s.eng = &stubEngine{}
+			old := weak.Make(s.Layout(largeParagraph("old")))
+			if clearCache {
+				s.clearLayouts()
+			} else {
+				for range liveLayoutFrames - 1 {
+					s.EndFrame()
+					if len(s.largeLayouts) == 0 {
+						t.Fatal("paragraph expired while still recent")
+					}
+				}
+				s.EndFrame()
+			}
+			if len(s.largeLayouts) != 0 || s.largeLayoutBytes != 0 {
+				t.Fatal("large-layout cache did not clear")
+			}
+			runtime.GC()
+			if old.Value() != nil {
+				t.Fatal("unused paragraph is still retained")
+			}
+			runtime.KeepAlive(s)
+		})
+	}
+}
+
+func TestLargeLayoutRejectsBeyondBudget(t *testing.T) {
+	s := newSystem()
+	s.eng = &stubEngine{}
+	p := largeParagraph("cached")
+	first := s.Layout(p)
+	huge := s.Layout(Params{Text: strings.Repeat("x", maxLargeLayoutBytes/64)})
+	if n := layoutBytes(&cached{layout: *huge}); n <= maxLargeLayoutBytes {
+		t.Fatalf("fixture does not exceed the budget: %d", n)
+	}
+	if len(huge.Runes) != maxLargeLayoutBytes/64 || len(huge.Lines) == 0 {
+		t.Fatal("uncached text did not lay out")
+	}
+	if len(s.largeLayouts) != 1 || s.Layout(p) != first {
+		t.Fatal("unadmittable paragraph evicted cached text")
+	}
+}
+
+func TestLargeLayoutInvalidatesChangedParams(t *testing.T) {
+	s := newSystem()
+	s.eng = &stubEngine{}
+	p := largeParagraph("original")
+	first := s.Layout(p)
+	p.Width = 500
+	if s.Layout(p) == first {
+		t.Fatal("width change reused stale layout")
+	}
+	p.Text += " edited"
+	if got := s.Layout(p); got.Params.Text != p.Text || got == first {
+		t.Fatal("edit reused stale layout")
+	}
+	s.clearLayouts()
+	made := s.LayoutsMade()
+	s.Layout(p)
+	if s.LayoutsMade() != made+1 {
+		t.Fatal("cache invalidation did not reshape")
+	}
+}
+
+func TestLargeLayoutReusesDisplayedParagraph(t *testing.T) {
+	s := newSystem()
+	s.eng = &stubEngine{}
+	p := largeParagraph("first")
+	first := s.Layout(p)
+	if n := layoutBytes(&cached{layout: *first}); n <= maxLayoutBytes {
+		t.Fatalf("fixture is not oversized: %d bytes", n)
+	}
+	for range 20 {
+		s.EndFrame()
+		if s.Layout(p) != first || s.Layout(p) != first {
+			t.Fatal("unchanged oversized paragraph was reshaped")
+		}
+	}
+	if n := s.LayoutsMade(); n != 1 {
+		t.Fatalf("made %d layouts, want 1", n)
+	}
+}
