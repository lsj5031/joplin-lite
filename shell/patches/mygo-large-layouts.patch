diff --git a/ui/markdown/large_layout_test.go b/ui/markdown/large_layout_test.go
new file mode 100644
index 0000000..58acde7
--- /dev/null
+++ b/ui/markdown/large_layout_test.go
@@ -0,0 +1,41 @@
+package markdown
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/egoist/mygo/internal/text"
+	"github.com/egoist/mygo/ui"
+)
+
+func largeParagraphTester() *ui.Tester {
+	src := strings.Repeat("中文 mixed punctuation。 https://example.com/path\n", 1700)
+	return ui.NewTester(func(c *ui.Context) {
+		ui.Scroll(c).Fill().Children(func() { View(c, src, nil) })
+	}, 700, 600)
+}
+
+func TestLargeParagraphWarmFramesReuseLayout(t *testing.T) {
+	tt := largeParagraphTester()
+	tt.Frame()
+	made := text.Shared().LayoutsMade()
+	for range 5 {
+		tt.Frame()
+	}
+	if n := text.Shared().LayoutsMade() - made; n != 0 {
+		t.Fatalf("unchanged Markdown reshaped %d layouts in warm frames", n)
+	}
+}
+
+func BenchmarkLargeParagraphWarmFrames(b *testing.B) {
+	tt := largeParagraphTester()
+	tt.Frame()
+	made := text.Shared().LayoutsMade()
+	b.ReportAllocs()
+	b.ResetTimer()
+	for range b.N {
+		tt.Frame()
+	}
+	b.StopTimer()
+	b.ReportMetric(float64(text.Shared().LayoutsMade()-made)/float64(b.N), "layouts/frame")
+}
