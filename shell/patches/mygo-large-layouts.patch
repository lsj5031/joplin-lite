 	p.Text = strings.Clone(p.Text)
@@ -658,8 +672,6 @@ func (s *System) Layout(p Params) *Layout {
 	p.Style.Lang = strings.Clone(p.Style.Lang)
 	c := s.layout(p)
 	c.bytes = layoutBytes(c)
-	// A large paragraph still lays out correctly; keeping it would evict
-	// all the ordinary labels and lines of other windows.
 	if c.bytes <= maxLayoutBytes {
 		for s.oldest != nil && (s.overLayoutBudget(c.bytes) || len(s.layouts) >= maxLayouts) {
 			s.removeLayout(s.oldest)
@@ -667,6 +679,8 @@ func (s *System) Layout(p Params) *Layout {
 		s.layouts[p] = c
 		s.layoutBytes += c.bytes
 		s.useLayout(c)
+	} else if c.bytes <= maxLargeLayoutBytes {
+		s.keepLargeLayout(p, c)
 	}
 	return &c.layout
 }
@@ -678,8 +692,30 @@ const (
 	maxLiveLayoutBytes = 64 << 20
 	maxLayoutBytes     = 8 << 20
 	maxLayouts         = 4096
+	// Additional, lazily used room for paragraphs above the ordinary
+	// admission limit. The combined estimated cache ceiling is 96 MiB.
+	maxLargeLayoutBytes = 32 << 20
 )
 
+func (s *System) keepLargeLayout(p Params, c *cached) {
+	for s.largeLayoutBytes+c.bytes > maxLargeLayoutBytes {
+		var oldest *cached
+		for _, entry := range s.largeLayouts {
+			if oldest == nil || entry.used < oldest.used {
+				oldest = entry
+			}
+		}
+		delete(s.largeLayouts, oldest.layout.Params)
+		s.largeLayoutBytes -= oldest.bytes
+	}
+	if s.largeLayouts == nil {
+		s.largeLayouts = make(map[Params]*cached)
+	}
+	c.used = s.frame
+	s.largeLayouts[p] = c
+	s.largeLayoutBytes += c.bytes
+}
+
 // Above the ordinary budget, keep layouts used within a few global frames:
 // otherwise sequential reuse of a larger working set evicts each layout just
 // before its next use. The hard cap and entry limit still apply to live text.
@@ -751,6 +787,8 @@ func (s *System) clearLayouts() {
 	}
 	clear(s.layouts)
 	s.layoutBytes = 0
+	clear(s.largeLayouts)
+	s.largeLayoutBytes = 0
 }
 
