# Golden corpus fixtures are compared byte-for-byte. Never let a checkout
# rewrite their line endings (Windows autocrlf turns the LF fixtures into CRLF
# and the whole format gate fails for reasons unrelated to the code).
internal/models/testdata/** -text

# Keep shell scripts and Go files on their committed line endings.
*.sh text eol=lf

# Dependency patches must apply to the LF sources in the Go module cache.
# Unified diffs require a space before context lines, including blank/tabbed ones.
shell/patches/*.patch text eol=lf whitespace=-blank-at-eol,-space-before-tab
